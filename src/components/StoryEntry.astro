---
import Gallery from "./Gallery.astro";
import Photo from "./Photo.astro";
import VideoMoment from "./VideoMoment.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"journal">;
}

const { entry } = Astro.props;
const { title, date, time, location, author, blocks } = entry.data;

const dateLabel = date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<article class="story">
  <div class="story-meta">
    <span title="Date">▧ <b>{dateLabel}</b></span>
    {time && <span title="Time">◷ <b>{time}</b></span>}
    <span title="Location">⌖ <b>{location}</b></span>
  </div>
  <h2>{title}</h2>
  {
    blocks.map((block) => {
      switch (block.type) {
        case "prose":
          return <p class="prose">{block.text}</p>;
        case "heading":
          return <h3>{block.text}</h3>;
        case "photo":
          return <Photo src={block.src} alt={block.alt} caption={block.caption} />;
        case "gallery":
          return <Gallery images={block.images} />;
        case "video":
          return (
            <VideoMoment
              src={block.src}
              poster={block.poster}
              caption={block.caption}
              duration={block.duration}
            />
          );
        default: {
          const _exhaustive: never = block;
          return _exhaustive;
        }
      }
    })
  }
  <div class="dispatch">Posted by <span>{author}</span> · {location}</div>
</article>
